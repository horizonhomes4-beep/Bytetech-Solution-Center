{
  "name": "MathCloud PWA Demo",
  "short_name": "MathCloud",
  "description": "A simple installable MathCloud Progressive Web App.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f8fafc",
  "theme_color": "#2563eb",
  "orientation": "portrait-primary",
