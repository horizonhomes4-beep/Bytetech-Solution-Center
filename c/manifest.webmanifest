{
  "id": "./",
  "name": "MathCloud Universal PWA",
  "short_name": "MathCloud",
  "description": "Install MathCloud as an app on supported phones, tablets and computers.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f8fafc",
